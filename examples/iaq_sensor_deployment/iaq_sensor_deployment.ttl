    ref:hasExternalReference [ ref:hasTimeseriesId "7fa89acd-7029-50ec-8602-9ed391afed11" ;
            ref:storedAt "mqtt://iaq-gateway.example.com:1883/home1/kitchen/occupancy" ] .


