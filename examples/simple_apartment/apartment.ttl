@prefix apt: <http://example.com/apartment#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix rec: <https://w3id.org/rec#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

<http://example.com/apartment> a owl:Ontology ;
    owl:imports <https://brickschema.org/schema/1.5/Brick> .

apt:bedroom a rec:Room ;
    brick:isPartOf apt:bedroom_lighting,
        apt:thermostat_zone .

apt:kitchen a rec:Room ;
    brick:isPartOf apt:kitchen_lighting,
        apt:thermostat_zone .

apt:living_room a rec:Room ;
    brick:isPartOf apt:living_room_lighting,
        apt:thermostat_zone .

apt:bedroom_lighting a rec:Zone .

apt:kitchen_lighting a rec:Zone .

apt:living_room_lighting a rec:Zone .

apt:my_apartment a rec:Apartment ;
    rec:includes apt:bedroom,
        apt:kitchen,
        apt:living_room .

apt:thermostat_zone a rec:HVACZone .
