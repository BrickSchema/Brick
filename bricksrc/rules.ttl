@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix rec: <https://w3id.org/rec#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bsh: <https://brickschema.org/schema/BrickShape#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# include this to inform reasoning
skos:broader rdf:type rdf:Property ;
  rdfs:label "has broader"@en ;
  owl:inverseOf skos:narrower ;
.

skos:narrower rdf:type rdf:Property ;
  rdfs:label "has narrower"@en ;
  owl:inverseOf skos:broader ;
.

##############################################################################
# Generic OWL/RDFS-style inference, implemented as SHACL rules
##############################################################################

# An alias class gets the superclasses of the class it aliases
bsh:AddSubclassAliasesRule
    a sh:NodeShape ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
CONSTRUCT {
    $this rdfs:subClassOf ?superclass .
} WHERE {
    # hop to the canonical class (optional), up one subClassOf, then to that
    # superclass's alias/equivalent (optional)
    $this (brick:aliasOf|owl:equivalentClass)?/rdfs:subClassOf/(brick:aliasOf|owl:equivalentClass)? ?superclass
}""" ;
      sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
    ] ;
    sh:targetSubjectsOf brick:aliasOf ;
.

# Copy every use of a property onto its equivalent properties. One-way by
# design: targets only the subject side, so brick:X -> rec:X, not back
bsh:EquivalentPropertyRule
  a sh:NodeShape ;
  sh:rule [
      a sh:SPARQLRule ;
      sh:construct """
CONSTRUCT {
    ?s ?t2 ?o .
} WHERE {
    # finds every use of this property...
    ?s $this ?o .
    # ...and its equivalent, declared in either direction
    { $this owl:equivalentProperty ?t2 }
    UNION
    { ?t2 owl:equivalentProperty $this }
}""" ;
      sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
    ] ;
  sh:targetSubjectsOf owl:equivalentProperty ;
.


# Copy every use of a property onto its direct superproperty (the rule engine
# iterates, so this reaches the whole chain)
bsh:SubPropertyOfRule
  a sh:NodeShape ;
  sh:rule [
      a sh:SPARQLRule ;
      sh:construct """
CONSTRUCT {
   ?s ?t2 ?o .
} WHERE {
    ?s $this ?o .
    { $this rdfs:subPropertyOf ?t2 }
}""" ;
      sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
    ] ;
    sh:targetSubjectsOf rdfs:subPropertyOf ;
.


# ?o p $this  =>  $this invP ?o, where invP owl:inverseOf p
bsh:InferInverseProperties
  a sh:NodeShape ;
  sh:rule [
      a sh:SPARQLRule ;
      sh:construct """
            CONSTRUCT {
$this ?invP ?o .
}
WHERE {
# an incoming edge to this entity...
?o ?p $this .
# ...whose property is declared as the inverse of another
?invP owl:inverseOf ?p .
}
			""" ;
      sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
    ] ;
  sh:targetClass brick:Entity ;
.

# Same as above, for owl:inverseOf declared in the other direction:
# ?o invP $this  =>  $this p ?o, where invP owl:inverseOf p
bsh:InferInverseProperties2
  a sh:NodeShape ;
  sh:rule [
      a sh:SPARQLRule ;
      sh:construct """
            CONSTRUCT {
$this ?p ?o .
}
WHERE {
?o ?invP $this .
?invP owl:inverseOf ?p .
}
			""" ;
      sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
    ] ;
  sh:targetClass brick:Entity ;
.

# Mirror every edge of an owl:SymmetricProperty touching this entity
bsh:InferSymmetricProperties
  a sh:NodeShape ;
  sh:rule [
      a sh:SPARQLRule ;
      sh:construct """
CONSTRUCT {
?o ?prop $this .
$this ?prop ?o .
}
WHERE {
  # an edge in either direction...
  { $this ?prop ?o } UNION { ?o ?prop $this } .
  # ...over a symmetric property
  ?prop a owl:SymmetricProperty .
}
			""" ;
      sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
    ] ;
  sh:targetClass brick:Entity ;
.

# An entity gets the tags of its class and of every superclass
bsh:TagInferenceRule
    a  sh:NodeShape ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
CONSTRUCT {
$this brick:hasTag ?tag .
} WHERE {
    # the entity's class or any superclass of it...
    $this rdf:type/rdfs:subClassOf* ?class .
    # ...and the tags associated with it
    ?class brick:hasAssociatedTag ?tag .
}""" ;
      sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
    ] ;
    sh:targetClass brick:Entity ;
.

# Type the values of a property with its rdfs:range, when that range is a
# NodeShape (e.g. the value nodes of entity properties)
bsh:RDFSRangeRule
    a   sh:NodeShape ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
CONSTRUCT {
    ?val a ?shape .
} WHERE {
    # the property's range is a shape, not a class...
    $this rdfs:range ?shape .
    ?shape a sh:NodeShape .
    # ...so type every value of the property with it, if not already
    ?ent $this ?val .
    FILTER NOT EXISTS { ?val a ?shape }
}""" ;
      sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
    ] ;
    sh:targetSubjectsOf rdfs:range ;
.

# Copy an entity property value up to every EntityProperty superproperty
# (e.g. brick:grossArea -> brick:area), copying the value node's contents too
bsh:RDFSSubPropertyOfRuleForEntityProperties
    a   sh:NodeShape ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
            CONSTRUCT {
                ?s ?super ?skolemized .
                ?skolemized ?ep ?eo .
            } WHERE {
                # every entity-property ancestor of this entity property
                $this rdfs:subPropertyOf+ ?super .
                ?super a brick:EntityProperty .
                $this a brick:EntityProperty .
                # every use of this property
                ?s $this ?o .
                # a blank value node is replaced by a fresh IRI so the copy
                # does not share the original node
                BIND(IF(isBlank(?o), IRI(CONCAT("urn:skolem:", STRUUID())), ?o) AS ?skolemized)
                # the contents of the value node (brick:value, brick:hasUnit, ...)
                ?o ?ep ?eo .
            }
        """ ;
        sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
    ] ;
    sh:targetSubjectsOf rdfs:subPropertyOf ;
.

##############################################################################
# Deprecation
##############################################################################

# Checks the metadata on a deprecated concept, and marks it owl:deprecated
bsh:DeprecationRule
    a   sh:NodeShape ;
    sh:rule [
        a sh:SPARQLRule ;
        sh:construct """
        CONSTRUCT { $this owl:deprecated true }
        WHERE { $this brick:deprecation ?dep }
        """ ;
      sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
    ] ;
    sh:property [
        sh:path brick:deprecatedInVersion ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path brick:deprecationMitigationMessage ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path brick:deprecationMitigationRule ;
        sh:class sh:NodeShape ;
        sh:maxCount 1 ;
    ] ;
    sh:targetSubjectsOf brick:deprecation ;
.

# An instance of a deprecated class also gets the class that replaces it
bsh:DeprecationInferenceForInstancesRule
    a  sh:NodeShape ;
sh:rule [ a sh:SPARQLRule ;
sh:message "Deprecated class is temporarily augmented by the new class" ;
sh:construct """CONSTRUCT {
$this a ?newClass .
}
WHERE {
# the entity has a deprecated class...
$this a ?class .
?class owl:deprecated true .
# ...which names a replacement the entity does not already have
?class brick:isReplacedBy ?newClass .
FILTER NOT EXISTS {$this a ?newClass}
}""" ;
      sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
    ] ;
    sh:targetClass brick:Entity ;
.

# Warns about each instance of a deprecated class
bsh:DeprecationRuleForInstances a sh:NodeShape ;
sh:severity sh:Warning ;
sh:sparql [ a sh:SPARQLConstraint ;
sh:message "{$this} has type {?class} which was deprecated in version {?depver}. For now, it has been updated to also be of type {?newClass}." ;
sh:prefixes <https://brickschema.org/schema/1.5/Brick> ;
sh:select """SELECT $this ?class ?newClass ?depver WHERE {
# the entity has a deprecated class, with its version and replacement
$this a ?class .
?class owl:deprecated true .
?class brick:deprecatedInVersion ?depver .
?class brick:isReplacedBy ?newClass .
}""" ] ;
sh:targetClass brick:Entity .


