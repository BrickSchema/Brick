unit:PlanckPower
  a qudt:Unit ;
  dcterms:description """The Planck energy divided by the Planck time is the Planck power $P_p $, equal to about $3.62831 \\times
    10^{52} W$. This is an extremely large unit; even gamma-ray bursts, the most luminous phenomena known, have output on the
    order of $1 \\times 10^{45} W$, less than one ten-millionth of the Planck power.
  """^^qudt:LatexString ;
  qudt:applicableSystem sou:PLANCK ;
  qudt:conversionMultiplier 36283100000000000000000000000000000000000000000000000.0 ;
  qudt:conversionMultiplierSN 3.62831E52 ;
