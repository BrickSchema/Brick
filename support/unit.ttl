unit:BIOT
  a qudt:Unit ;
  dcterms:description """"Biot" is another name for the abampere (aA), which is the basic electromagnetic unit of electric current
    in the emu-cgs (centimeter-gram-second) system of units. It is called after a French physicist, astronomer, and mathematician
    Jean-Baptiste Biot. One abampere is equal to ten amperes in the SI system of units. One abampere is the current, which
    produces a force of 2 dyne/cm between two infinitively long parallel wires that are 1 cm apart.
  """^^rdf:HTML ;
  qudt:applicableSystem sou:CGS ;
  qudt:applicableSystem sou:CGS-EMU ;
  qudt:conversionMultiplier 10.0 ;
  qudt:conversionMultiplierSN 1.0E1 ;
