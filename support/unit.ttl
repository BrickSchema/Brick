unit:A-PER-M
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description """is the SI unit of magnetic field strength. One ampere per meter is equal to $\\pi/250$ oersteds
    ($12.566\\, 371\\,millioersteds$) in CGS units. The ampere per meter is also the SI unit of "magnetization" in the sense of
    magnetic dipole moment per unit volume; in this context $1 A/m = 0.001\\,emu\\,per\\,cubic\\,centimeter$.
  """^^qudt:LatexString ;
  qudt:applicableSystem sou:CGS-EMU ;
  qudt:applicableSystem sou:CGS-GAUSS ;
