  qudt:informativeReference "https://en.wikipedia.org/wiki/Abvolt?oldid=477198646"^^xsd:anyURI ;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/abvolt> ;
  qudt:scalingOf unit:V ;
  qudt:symbol "abV" ;
  qudt:ucumCode "10.nV"^^qudt:UCUMcs ;
  qudt:unitForQuantityKind quantitykind:ElectricPotential ;
  qudt:unitForQuantityKind quantitykind:ElectricPotentialDifference ;
  qudt:unitForQuantityKind quantitykind:EnergyPerElectricCharge ;
  qudt:unitForQuantityKind quantitykind:Voltage ;
  qudt:wikidataMatch <http://www.wikidata.org/entity/Q2232211> ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
  rdfs:label "Abvolt"@en ;
  rdfs:label "Abvolt" .

