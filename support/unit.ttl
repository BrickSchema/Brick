    a qudt:FactorUnit ;
    qudt:exponent -1 ;
    qudt:hasUnit unit:L ;
  ] ;
  qudt:hasFactorUnit [
    a qudt:FactorUnit ;
    qudt:exponent 1 ;
    qudt:hasUnit unit:NanoKAT ;
  ] ;
  qudt:hasQuantityKind quantitykind:CatalyticActivityConcentration ;
  qudt:symbol "nkat/L" ;
  qudt:ucumCode "nkat.L-1"^^qudt:UCUMcs ;
  qudt:unitForQuantityKind quantitykind:CatalyticActivityConcentration ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
  rdfs:label "Nanokatal per Liter"@en-US ;
  rdfs:label "Nanokatal per Litre"@en ;
  rdfs:label "Nanokatal per Litre" .

