unit:BARYE
  a qudt:Unit ;
  dcterms:description """<p>The barye, or sometimes barad, barrie, bary, baryd, baryed, or barie, is the centimetre-gram-second
    (CGS) unit of pressure. It is equal to 1 dyne per square centimetre.</p>
  """^^rdf:HTML ;
  qudt:applicableSystem sou:CGS ;
  qudt:conversionMultiplier 0.1 ;
