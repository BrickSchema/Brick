unit:PHOT
  a qudt:Unit ;
  dcterms:description """A phot (ph) is a photometric unit of illuminance, or luminous flux through an area. It is not an SI unit,
    but rather is associated with the older centimetre gram second system of units.  Metric dimensions: $illuminance = luminous
    intensity \\times solid angle / length$.
  """^^qudt:LatexString ;
