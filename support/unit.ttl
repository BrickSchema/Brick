  qudt:hasDimensionVector qkdv:A0E1L0I0M0H0T0D0 ;
  qudt:hasQuantityKind quantitykind:ElectricCurrent ;
  qudt:iec61360Code "0112/2///62720#UAB210" ;
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB210"^^xsd:anyURI ;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Abampere"^^xsd:anyURI ;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Biot?oldid=443318821"^^xsd:anyURI ;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/biot> ;
  qudt:scalingOf unit:A ;
  qudt:symbol "Bi" ;
