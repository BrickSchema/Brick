unit:K-PER-W
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description """<p>Thermal resistance is a heat property and a measure of a temperature difference by which an object or
    material resists a heat flow (heat per time unit or thermal resistance). Thermal resistance is the reciprocal thermal
    conductance. Absolute thermal resistance is the temperature difference across a structure when a unit of heat energy flows
    through it in unit time. It is the reciprocal of thermal conductance. The SI units of thermal resistance are kelvins per watt
    or the equivalent degrees Celsius per watt (the two are the same since as intervals).</p>
  """^^rdf:HTML ;
  qudt:applicableSystem sou:SI ;
  qudt:conversionMultiplier 1.0 ;
  qudt:conversionMultiplierSN 1.0E0 ;
  qudt:definedUnitOfSystem sou:SI ;
  qudt:derivedCoherentUnitOfSystem sou:SI ;
  qudt:expression "$K/W$"^^qudt:LatexString ;
