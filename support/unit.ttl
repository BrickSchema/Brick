  qudt:definedUnitOfSystem sou:USCS ;
  qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T1D0 ;
  qudt:hasQuantityKind quantitykind:HalfLife ;
  qudt:hasQuantityKind quantitykind:MeanLifetime ;
  qudt:hasQuantityKind quantitykind:Time ;
  qudt:iec61360Code "0112/2///62720#UAA525" ;
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA525"^^xsd:anyURI ;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Hour?oldid=495040268"^^xsd:anyURI ;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/hour> ;
  qudt:scalingOf unit:SEC ;
