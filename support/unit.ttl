unit:GRAY
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description """The SI unit of radiation dose. Radiation carries energy, and when it is absorbed by matter the matter
    receives this energy. The dose is the amount of energy deposited per unit of mass. One gray is defined to be the dose of one
    joule of energy absorbed per kilogram of matter, or 100 rad. The unit is named for the British physician L. Harold Gray
    (1905-1965), an authority on the use of radiation in the treatment of cancer.
  """^^rdf:HTML ;
  qudt:applicableSystem sou:CGS ;
  qudt:applicableSystem sou:CGS-EMU ;
  qudt:applicableSystem sou:CGS-GAUSS ;
  qudt:applicableSystem sou:SI ;
  qudt:conversionMultiplier 1.0 ;
