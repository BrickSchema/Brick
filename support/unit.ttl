  qudt:prefix prefix:Kilo ;
  qudt:scalingOf unit:PA ;
  qudt:symbol "kPa" ;
  qudt:ucumCode "kPa"^^qudt:UCUMcs ;
  qudt:uneceCommonCode "KPA" ;
  qudt:unitForQuantityKind quantitykind:ForcePerArea ;
  qudt:unitForQuantityKind quantitykind:ModulusOfElasticity ;
  qudt:wikidataMatch <http://www.wikidata.org/entity/Q21064807> ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
