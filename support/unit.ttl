unit:M3-PER-MOL
  a qudt:Unit ;
  dcterms:description """<p>The molar volume, symbol $Vm$, is the volume occupied by one mole of a substance (chemical element or
    chemical compound) at a given temperature and pressure. It is equal to the molar mass (M) divided by the mass density. It has
    the SI unit cubic metres per mole $m3/mol$, although it is more practical to use the units cubic decimetres per mole $dm3/mol$
    for gases and cubic centimetres per mole $cm3/mol$ for liquids and solids</p>.
  """^^qudt:LatexString ;
  qudt:applicableSystem sou:SI ;
  qudt:conversionMultiplier 1.0 ;
  qudt:conversionMultiplierSN 1.0E0 ;
  qudt:derivedCoherentUnitOfSystem sou:SI ;
