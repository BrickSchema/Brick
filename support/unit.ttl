    qudt:exponent -1 ;
    qudt:hasUnit unit:SEC ;
  ] ;
  qudt:hasFactorUnit [
    a qudt:FactorUnit ;
    qudt:exponent 1 ;
    qudt:hasUnit unit:V ;
  ] ;
  qudt:hasQuantityKind quantitykind:PowerPerElectricCharge ;
  qudt:hasQuantityKind quantitykind:RateOfRiseOfVoltage ;
  qudt:iec61360Code "0112/2///62720#UAA304" ;
