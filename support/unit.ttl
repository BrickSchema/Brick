unit:MilliEQ-PER-L
  a qudt:Unit ;
  dcterms:description "Milliequivalent per litre is the dominant unit used in clinical chemistry for reporting concentrations of electrolytes (sodium, potassium, chloride, bicarbonate, calcium, magnesium) in serum, plasma, and urine. One milliequivalent expresses the amount of an ionic species in terms of its chemical combining power, accounting for the ion's charge. For monovalent ions (Na+, K+, Cl-, HCO3-) one milliequivalent per litre equals one millimole per litre; for divalent ions (Ca2+, Mg2+) one milliequivalent per litre equals one half millimole per litre." ;
  qudt:conversionMultiplier 1.0 ;
  qudt:conversionMultiplierSN 1.0E0 ;
  qudt:hasDimensionVector qkdv:A1E0L-3I0M0H0T0D0 ;
  qudt:hasFactorUnit [
    a qudt:FactorUnit ;
    qudt:exponent -1 ;
    qudt:hasUnit unit:L ;
  ] ;
  qudt:hasFactorUnit [
    a qudt:FactorUnit ;
    qudt:exponent 1 ;
    qudt:hasUnit unit:MilliEQ ;
  ] ;
  qudt:hasQuantityKind quantitykind:EquivalentConcentration ;
  qudt:plainTextDescription "Milliequivalent per litre is the dominant unit used in clinical chemistry for reporting electrolyte concentrations in serum, plasma, and urine." ;
  qudt:symbol "mEq/L" ;
  qudt:ucumCode "mEQ.L-1"^^qudt:UCUMcs ;
  qudt:unitForQuantityKind quantitykind:EquivalentConcentration ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
  rdfs:label "Milliequivalent per Liter"@en-US ;
  rdfs:label "Milliequivalent per Litre"@en ;
  rdfs:label "Milliequivalent per Litre" .

unit:MilliEQ-PER-MilliL
  a qudt:Unit ;
  dcterms:description "Milliequivalent per millilitre is the unit commonly used to label intravenous electrolyte concentrate preparations such as potassium chloride concentrate (typically 2 mEq/mL) and sodium chloride concentrate. One milliequivalent per millilitre equals one thousand milliequivalents per litre, or one equivalent per litre." ;
  qudt:conversionMultiplier 1000.0 ;
  qudt:conversionMultiplierSN 1.0E3 ;
  qudt:hasDimensionVector qkdv:A1E0L-3I0M0H0T0D0 ;
  qudt:hasFactorUnit [
    a qudt:FactorUnit ;
    qudt:exponent -1 ;
    qudt:hasUnit unit:MilliL ;
  ] ;
  qudt:hasFactorUnit [
    a qudt:FactorUnit ;
    qudt:exponent 1 ;
    qudt:hasUnit unit:MilliEQ ;
  ] ;
  qudt:hasQuantityKind quantitykind:EquivalentConcentration ;
  qudt:plainTextDescription "Milliequivalent per millilitre; the unit commonly used to label intravenous electrolyte concentrate preparations." ;
  qudt:symbol "mEq/mL" ;
  qudt:ucumCode "mEQ.mL-1"^^qudt:UCUMcs ;
  qudt:unitForQuantityKind quantitykind:EquivalentConcentration ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
  rdfs:label "Milliequivalent per Milliliter"@en-US ;
  rdfs:label "Milliequivalent per Millilitre"@en ;
  rdfs:label "Milliequivalent per Millilitre" .

