unit:N
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description """The "Newton" is the SI unit of force. A force of one newton will accelerate a mass of one kilogram at the
    rate of one meter per second per second. The newton is named for Isaac Newton (1642-1727), the British mathematician,
    physicist, and natural philosopher. He was the first person to understand clearly the relationship between force (F), mass
    (m), and acceleration (a) expressed by the formula $F = m \\cdot a$.
  """^^qudt:LatexString ;
  qudt:applicableSystem sou:CGS ;
  qudt:applicableSystem sou:CGS-EMU ;
  qudt:applicableSystem sou:CGS-GAUSS ;
  qudt:applicableSystem sou:SI ;
