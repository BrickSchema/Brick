  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/metre> ;
  qudt:plainTextDescription """The metric and SI base unit of distance.   The meter is equal to approximately 1.093 613 3 yards,
    3.280 840 feet, or 39.370 079 inches.
  """ ;
  qudt:siExactMatch si-unit:metre ;
