unit:TeraBYTE
  a qudt:CountingUnit, qudt:Unit ;
  dcterms:description """The terabyte is a multiple of the unit byte for digital information. The prefix tera means 10^12 in the
    International System of Units (SI), and therefore 1 terabyte is 1000000000000bytes, or 1 trillion bytes, or 1000 gigabytes. 1
    terabyte in binary prefixes is 0.9095 tebibytes, or 931.32 gibibytes. The unit symbol for the terabyte is TB or TByte, but not
    Tb (lower case b) which refers to terabit.
  """^^rdf:HTML ;
  qudt:applicableSystem sou:ASU ;
  qudt:applicableSystem sou:CGS ;
  qudt:applicableSystem sou:CGS-EMU ;
