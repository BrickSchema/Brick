unit:S_Ab
  a qudt:Unit ;
  dcterms:description """The CGS electromagnetic unit of conductance; one absiemen is the conductance at which a potential of one
    abvolt forces a current of one abampere; equal to $10^{9}$ siemens. One siemen is the conductance at which a potential of one
    volt forces a current of one ampere and named for Karl Wilhem Siemens.
  """^^qudt:LatexString ;
  qudt:applicableSystem sou:CGS ;
  qudt:applicableSystem sou:CGS-EMU ;
