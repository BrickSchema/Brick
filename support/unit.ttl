  qudt:hasQuantityKind quantitykind:Power ;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Planck_power?oldid=493642483"^^xsd:anyURI ;
  qudt:latexDefinition "$P_p = {\\frac{ c^5}{G}}$, where $c$ is the speed of light in a vacuum, and $G$ is the gravitational constant."^^qudt:LatexString ;
  qudt:scalingOf unit:J-PER-SEC ;
  qudt:symbol "planckpower" ;
  qudt:unitForQuantityKind quantitykind:Power ;
  qudt:wikidataMatch <http://www.wikidata.org/entity/Q914151> ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
