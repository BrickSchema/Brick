  qudt:unitForQuantityKind quantitykind:ThermalEnergy ;
  qudt:wikidataMatch <http://www.wikidata.org/entity/Q99490009> ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
  rdfs:label "British Thermal Unit (international Definition)"@en ;
  rdfs:label "British Thermal Unit (international Definition)" .

