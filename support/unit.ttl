unit:OHM
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description """The $\\textit{ohm}$ is the SI derived unit of electrical resistance, named after German physicist Georg
    Simon Ohm.  It is defined as:  $$\\Omega \\equiv\\ \\frac{\\text{V}}{\\text{A}}\\ \\equiv\\
    \\frac{\\text{volt}}{\\text{amp}}\\ \\equiv\\ \\frac{\\text{W}}{\\text {A}^{2}}\\ \\equiv\\
    \\frac{\\text{watt}}{\\text{amp}^{2}}\\ \\equiv\\ \\frac{\\text{H}}{\\text {s}}\\ \\equiv\\
    \\frac{\\text{henry}}{\\text{second}}$$
  """^^qudt:LatexString ;
