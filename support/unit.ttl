  qudt:dbpediaMatch "http://dbpedia.org/resource/Byte"^^xsd:anyURI ;
  qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1 ;
  qudt:hasQuantityKind quantitykind:AmountOfData ;
  qudt:hasQuantityKind quantitykind:ByteDataVolume ;
  qudt:hasQuantityKind quantitykind:DatasetOfBytes ;
  qudt:iec61360Code "0112/2///62720#UAB129" ;
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB129"^^xsd:anyURI ;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Byte?oldid=493588918"^^xsd:anyURI ;
  qudt:prefix prefix:Kilo ;
  qudt:scalingOf unit:BYTE ;
  qudt:symbol "kB" ;
  qudt:ucumCode "kBy"^^qudt:UCUMcs ;
  qudt:uneceCommonCode "2P" ;
  qudt:unitForQuantityKind quantitykind:AmountOfData ;
