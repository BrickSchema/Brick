unit:SLUG
  a qudt:Unit ;
  dcterms:description """The slug is a unit of mass associated with Imperial units. It is a mass that accelerates by $1 ft/s$ when
    a force of one pound-force ($lbF$) is exerted on it. With standard gravity $gc = 9.80665 m/s$, the international foot of
    $0.3048 m$ and the avoirdupois pound of $0.45359237 kg$, one slug therefore has a mass of approximately $32.17405 lbm$ or
    $14.593903 kg$. At the surface of the Earth, an object with a mass of 1 slug exerts a force of about $32.17 lbF$ or $143 N$.
  """^^qudt:LatexString ;
  qudt:applicableSystem sou:IMPERIAL ;
  qudt:conversionMultiplier 14.59390293720636482939632545931758 ;
  qudt:conversionMultiplierSN 1.459390293720636482939632545931758E1 ;
