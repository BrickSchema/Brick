  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA425"^^xsd:anyURI ;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Electron_volt?oldid=344021738"^^xsd:anyURI ;
  qudt:scalingOf unit:J ;
  qudt:siExactMatch si-unit:electronvolt ;
  qudt:symbol "eV" ;
  qudt:ucumCode "eV"^^qudt:UCUMcs ;
  qudt:udunitsCode "eV" ;
