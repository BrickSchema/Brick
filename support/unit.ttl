  qudt:hasFactorUnit [
    a qudt:FactorUnit ;
    qudt:exponent 1 ;
    qudt:hasUnit unit:SCF ;
  ] ;
  qudt:hasQuantityKind quantitykind:CurrentOfTheAmountOfSubstance ;
  qudt:hasQuantityKind quantitykind:MolarFlowRate ;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Standard_cubic_feet_per_minute"^^xsd:anyURI ;
  qudt:symbol "scf/h" ;
  qudt:unitForQuantityKind quantitykind:CurrentOfTheAmountOfSubstance ;
  qudt:unitForQuantityKind quantitykind:MolarFlowRate ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
  rdfs:label "Standard Cubic Foot per Hour"@en ;
  rdfs:label "Standard Cubic Foot per Hour" .

