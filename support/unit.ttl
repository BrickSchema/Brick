unit:V_Ab
  a qudt:Unit ;
  dcterms:description """A unit of electrical potential equal to one hundred millionth of a volt ($10^{-8}\\,volts$), used in the
    centimeter-gram-second (CGS) system of units. One abV is the potential difference that exists between two points when the work
    done to transfer one abcoulomb of charge between them equals: $1\\,erg\\cdot\\,1\\,abV\\,=\\,10\\,nV$.
  """^^qudt:LatexString ;
  qudt:applicableSystem sou:CGS ;
  qudt:applicableSystem sou:CGS-EMU ;
  qudt:conversionMultiplier 0.00000001 ;
  qudt:conversionMultiplierSN 1.0E-8 ;
