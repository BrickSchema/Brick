unit:BQ-PER-M3
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description """Becquerel Per Cubic Meter ($Bq/m3$) is a unit in the category of Radioactivity concentration. It is also
    known as becquerels per cubic meter, becquerel per cubic metre, becquerels per cubic metre, becquerel/cubic inch. This unit is
    commonly used in the SI unit system. Becquerel Per Cubic Meter (Bq/m3) has a dimension of $L{-3}T{-1}$ where $L$ is length,
    and $T$ is time. It essentially the same as the corresponding standard SI unit $/s\\cdot m{3}$.
  """^^qudt:LatexString ;
  qudt:applicableSystem sou:CGS ;
  qudt:applicableSystem sou:CGS-EMU ;
  qudt:applicableSystem sou:CGS-GAUSS ;
