  rdfs:label "Volt na Čtvereční Metr"@cs ;
  rdfs:label "Volt par Mètre Carré"@fr ;
  rdfs:label "Volt pe Metru Pătrat"@ro ;
  rdfs:label "Volt per Meter Persegi"@ms ;
