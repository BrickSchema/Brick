    qudt:hasUnit unit:V ;
  ] ;
  qudt:hasQuantityKind quantitykind:ElectricField ;
  qudt:hasQuantityKind quantitykind:ElectricFieldStrength ;
  qudt:iec61360Code "0112/2///62720#UAA301" ;
