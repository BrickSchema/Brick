  qudt:conversionMultiplier 9007199254740992.0 ;
  qudt:conversionMultiplierSN 9.007199254740992E15 ;
  qudt:dbpediaMatch "http://dbpedia.org/resource/Pebibyte"^^xsd:anyURI ;
  qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1 ;
  qudt:hasQuantityKind quantitykind:AmountOfData ;
  qudt:hasQuantityKind quantitykind:ByteDataVolume ;
  qudt:hasQuantityKind quantitykind:DatasetOfBytes ;
  qudt:iec61360Code "0112/2///62720#UAA274" ;
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA274"^^xsd:anyURI ;
  qudt:informativeReference "https://en.wikipedia.org/wiki/Pebibyte?oldid=492685015"^^xsd:anyURI ;
  qudt:prefix prefix:Pebi ;
  qudt:scalingOf unit:BYTE ;
  qudt:symbol "PiB" ;
  qudt:uneceCommonCode "E60" ;
  qudt:unitForQuantityKind quantitykind:AmountOfData ;
  qudt:unitForQuantityKind quantitykind:ByteDataVolume ;
  qudt:unitForQuantityKind quantitykind:DatasetOfBytes ;
  qudt:wikidataMatch <http://www.wikidata.org/entity/Q79774> ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
  rdfs:label "Pebibyte"@en ;
  rdfs:label "Pebibyte" .

