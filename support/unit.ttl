unit:V-PER-SEC
  a qudt:Unit ;
  dcterms:description """'Volt per Second' is a unit of magnetic flux equaling one weber. This is the flux passing through a
    conducting loop and reduced to zero at a uniform rate in one second inducing an electric potential of one volt in the loop.
  """^^rdf:HTML ;
  qudt:applicableSystem sou:CGS-EMU ;
  qudt:applicableSystem sou:CGS-GAUSS ;
  qudt:applicableSystem sou:SI ;
  qudt:conversionMultiplier 1.0 ;
