unit:LB-PER-HR
  a qudt:Unit ;
  dcterms:description """Pound per hour is a mass flow unit. It is abbreviated as PPH or more conventionally as lb/h. Fuel flow
    for engines is usually expressed using this unit, it is particularly useful when dealing with gases or liquids as volume flow
    varies more with temperature and pressure. $1 lb/h = 0.4535927 kg/h = 126.00 mg/s$.  Minimum fuel intake on a jumbojet can be
    as low as 150 lb/h when idling, however this is not enough to sustain flight.
  """^^qudt:LatexString ;
  qudt:applicableSystem sou:CGS ;
  qudt:applicableSystem sou:IMPERIAL ;
  qudt:applicableSystem sou:USCS ;
  qudt:conversionMultiplier 0.0001259978805555555555555555555555556 ;
  qudt:conversionMultiplierSN 1.259978805555555555555555555555556E-4 ;
