unit:N-M
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description """"Torque" is the tendency of a force to cause a rotation, is the product of the force and the distance
    from the center of rotation to the point where the force is applied. Torque has the same units as work or energy, but it is a
    different physical concept. To stress the difference, scientists measure torque in newton meters rather than in joules, the SI
    unit of work. One newton meter is approximately 0.737562 pound foot.
  """^^rdf:HTML ;
  qudt:applicableSystem sou:CGS ;
  qudt:applicableSystem sou:CGS-EMU ;
  qudt:applicableSystem sou:CGS-GAUSS ;
