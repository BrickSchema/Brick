unit:IU
  a qudt:Unit ;
  dcterms:description """
  The $\\textit{International Unit}$ ($IU$) is a substance-dependent reference unit of biological activity used in
   pharmacology. For any given substance, one $IU$ is defined as the activity of a fixed mass of an international
   reference preparation (e.g. a WHO International Standard), so a conversion to mass exists but differs from one
   substance to another; it is therefore resolved at the level of a concrete quantity rather than stated here
   (hence $conversionMultiplier = 0.0$). For this reason the unit is dimensioned as mass ($M$) and modelled as a
   mass-equivalent, not as amount of substance ($N$): one $IU$ is not a fixed number of moles. This follows the same
   pattern QUDT uses for other substance-dependent equivalents (e.g. mass equivalent, CO2 equivalent), where the
   base dimension is retained and the per-substance factor is pinned at the quantity level.
  """^^qudt:LatexString ;
  qudt:conversionMultiplier 0.0 ;
  qudt:conversionMultiplierSN 0.0E0 ;
  qudt:dbpediaMatch "http://dbpedia.org/resource/International_unit"^^xsd:anyURI ;
  qudt:hasDimensionVector qkdv:A0E0L0I0M1H0T0D0 ;
  qudt:hasQuantityKind quantitykind:AmountOfBiologicallyActiveSubstance ;
  qudt:iec61360Code "0112/2///62720#UAB603" ;
  qudt:informativeReference "https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB603"^^xsd:anyURI ;
  qudt:informativeReference "https://en.wikipedia.org/wiki/International_unit?oldid=488801913"^^xsd:anyURI ;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/InternationalUnit> ;
  qudt:symbol "IU" ;
  qudt:ucumCode "[IU]"^^qudt:UCUMcs ;
  qudt:unitForQuantityKind quantitykind:AmountOfBiologicallyActiveSubstance ;
  qudt:wikidataMatch <http://www.wikidata.org/entity/Q835916> ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
  rdfs:label "International Unit"@en ;
  rdfs:label "International Unit" .

unit:IU-PER-L
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description """
The $\\textit{International Unit per Liter}$ is a unit for 'Serum Or Plasma Level' expressed as $IU/L$.
The magnitude of one $IU/L$ depends on the material, so there is no single conversion multiplier.
Following the mass-equivalent treatment of $IU$ (see unit:IU), this is dimensioned as a mass concentration.
"""^^qudt:LatexString ;
  qudt:conversionMultiplier 0.0 ;
  qudt:conversionMultiplierSN 0.0E0 ;
  qudt:expression "$IU/L$"^^qudt:LatexString ;
  qudt:hasDimensionVector qkdv:A0E0L-3I0M1H0T0D0 ;
  qudt:hasFactorUnit [
    a qudt:FactorUnit ;
    qudt:exponent -1 ;
    qudt:hasUnit unit:L ;
  ] ;
  qudt:hasFactorUnit [
    a qudt:FactorUnit ;
    qudt:exponent 1 ;
    qudt:hasUnit unit:IU ;
  ] ;
  qudt:hasQuantityKind quantitykind:PlasmaLevel ;
  qudt:hasQuantityKind quantitykind:SerumLevel ;
  qudt:symbol "IU/L" ;
  qudt:ucumCode "[IU].L-1"^^qudt:UCUMcs ;
  qudt:unitForQuantityKind quantitykind:PlasmaLevel ;
  qudt:unitForQuantityKind quantitykind:SerumLevel ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
  rdfs:label "International Unit per Liter"@en-US ;
  rdfs:label "International Unit per Litre"@en ;
  rdfs:label "International Unit per Litre" ;
  rdfs:seeAlso unit:IU .

unit:IU-PER-MilliGM
  a qudt:Unit ;
  dcterms:description """
<p>International Unit per milligramme.
The magnitude of one $IU/mg$ depends on the material, so there is no single conversion multiplier.
Following the mass-equivalent treatment of $IU$ (see unit:IU), $IU/mg$ is a mass-equivalent per mass and is therefore
dimensionless (a potency or mass fraction).
</p>"""^^rdf:HTML ;
  qudt:conversionMultiplier 0.0 ;
  qudt:conversionMultiplierSN 0.0E0 ;
  qudt:hasDimensionVector qkdv:A0E0L0I0M0H0T0D1 ;
  qudt:hasFactorUnit [
    a qudt:FactorUnit ;
    qudt:exponent -1 ;
    qudt:hasUnit unit:MilliGM ;
  ] ;
  qudt:hasFactorUnit [
    a qudt:FactorUnit ;
    qudt:exponent 1 ;
    qudt:hasUnit unit:IU ;
  ] ;
  qudt:hasQuantityKind quantitykind:MassFraction ;
  qudt:plainTextDescription "International Units per milligramme." ;
  qudt:symbol "IU/mg" ;
  qudt:ucumCode "[IU].mg-1"^^qudt:UCUMcs ;
  qudt:unitForQuantityKind quantitykind:MassFraction ;
