  qudt:informativeReference "https://en.wikipedia.org/wiki/Stère?oldid=393570287"^^xsd:anyURI ;
  qudt:omUnit <http://www.ontology-of-units-of-measure.org/resource/om-2/stere> ;
  qudt:scalingOf unit:M3 ;
  qudt:symbol "st" ;
  qudt:ucumCode "st"^^qudt:UCUMcs ;
  qudt:uneceCommonCode "G26" ;
  qudt:unitForQuantityKind quantitykind:Volume ;
  qudt:wikidataMatch <http://www.wikidata.org/entity/Q1585993> ;
  rdfs:isDefinedBy <http://qudt.org/3.5.2/vocab/unit> ;
  rdfs:label "Stere"@en ;
