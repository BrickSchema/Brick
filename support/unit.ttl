unit:PA-SEC-PER-M
  a qudt:DerivedUnit, qudt:Unit ;
  dcterms:description """Pascal Second Per Meter ($Pa-s/m$) is a unit in the category of Specific acoustic impedance. It is also
    known as pascal-second/meter. Pascal Second Per Meter has a dimension of $ML^2T^{-1}$ where $M$ is mass, $L$ is length, and
    $T$ is time. It essentially the same as the corresponding standard SI unit $kg/m2\\cdot s$.
  """^^qudt:LatexString ;
