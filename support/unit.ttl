unit:YD
  a qudt:Unit ;
  dcterms:description """A yard is a unit of length in several different systems including United States customary units, Imperial
    units and the former English units. It is equal to 3 feet or 36 inches. Under an agreement in 1959 between Australia, Canada,
    New Zealand, South Africa, the United Kingdom and the United States, the yard (known as the "international yard" in the United
    States) was legally defined to be exactly 0.9144 metres.
  """^^rdf:HTML ;
  qudt:applicableSystem sou:IMPERIAL ;
  qudt:applicableSystem sou:USCS ;
  qudt:conversionMultiplier 0.9144 ;
  qudt:conversionMultiplierSN 9.144E-1 ;
