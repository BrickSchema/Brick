unit:BAN
  a qudt:Unit ;
  dcterms:description """
  A $\\textit{ban}$ is a logarithmic unit which measures information or entropy,
   based on base 10 logarithms and powers of 10, rather than the base 2
   logarithms which define the shannon.
  One $\\textit{ban}$ is approximately $3.32 (log_2 10) shannon$.
  """^^qudt:LatexString ;
  qudt:applicableSystem sou:ASU ;
  qudt:applicableSystem sou:CGS ;
  qudt:applicableSystem sou:CGS-EMU ;
  qudt:applicableSystem sou:CGS-ESU ;
